# 🔴 本机 registry.npmjs.org 不可达，必须使用镜像（见 CONTRIBUTING.md D-13）
# CI 环境如需切回官方源：NPM_CONFIG_REGISTRY=https://registry.npmjs.org/
registry=https://registry.npmmirror.com/

# 严格 node_modules
# 🔶 偏离说明：原为 isolated（pnpm 默认 symlink 布局），但工作区在 NFS 网络盘上，
#    Windows 报 ENOTSUP（不支持 symlink），故改用 hoisted（npm 风格，实复制）。
#    牺牲磁盘占用换 NFS 可用性。详见 CONTRIBUTING.md 偏离登记 D-16。
node-linker=hoisted
shamefully-hoist=true

# 严格 peer deps：防止隐式版本冲突
strict-peer-dependencies=true
auto-install-peers=false
