#!/bin/bash
# cmd/uninstall_callback —— 卸载清理【后】执行
# 官方时机：卸载清理后。用于清理容器与网络，保留数据卷。

set -u

LOG_FILE="${TRIM_PKGVAR}/logs/uninstall.log"
COMPOSE_FILE="${TRIM_APPDEST}/docker/docker-compose.yaml"

log() {
    mkdir -p "$(dirname "${LOG_FILE}")" 2>/dev/null
    echo "$(date '+%Y-%m-%d %H:%M:%S') [uninstall_callback] $1" >> "${LOG_FILE}"
}

log "=== 卸载后清理 ==="

# 停止并移除容器与网络
if [ -f "${COMPOSE_FILE}" ]; then
    cd "${TRIM_APPDEST}/docker" 2>/dev/null \
        && docker compose -p englishforge -f "${COMPOSE_FILE}" down --remove-orphans 2>/dev/null \
        && log "容器与网络已清理" \
        || log "WARN: compose down 失败（可能已清理）"
else
    log "compose 文件不存在，跳过"
fi

# 清理残留容器
docker ps -aq --filter "name=englishforge" 2>/dev/null | xargs -r docker rm -f 2>/dev/null || true

# 🔴 保留镜像与数据
# - 镜像保留：便于重装时免去 1-3 分钟导入（用户可自行 docker rmi 清理）
# - 数据保留：见 uninstall_init 的说明
log "已保留镜像与数据目录（重装后数据仍在）"
log "彻底清除请手动执行：docker system prune -a && rm -rf ${TRIM_PKGVAR}"

exit 0
