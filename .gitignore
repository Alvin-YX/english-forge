node_modules/
dist/
build/
coverage/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# 生成物
packages/contracts/src/generated/
packages/db/migrations/
*.tsbuildinfo
docs/api/

# 环境与密钥（硬性：禁止提交）
.env
.env.local
*.pem
*.key
secrets/
!ops/compose/.env.template

# 媒体与模型（大文件，不入 git）
# 🔴 必须锚定到仓库根：裸 `media/` 会连带忽略源码目录 apps/api/src/modules/media/
/media/
models/
dictionary/*.db
dictionary/*.sqlite

# 编辑器
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# 日志
*.log
npm-debug.log*
pnpm-debug.log*

# NFS workarounds
_tmp_*

# 构建/测试工具产生的临时文件（vite、vitest 每次运行都会生成）
*.timestamp-*.mjs

# 运行时数据（词库导入产物、SQLite 测试库等）
# 注意：必须写成 /data/* 而不是 /data/ —— 整目录忽略后 git 不会下钻，
# 后面的 ! 否定规则对目录内的文件无效，样例字典就永远进不了仓库。
/data/*
!/data/sample-ecdict.csv

# reinstall-deps.sh 重装依赖时的中间目录（内含 symlink，git 无法遍历）
node_modules.old.*/

# 构建产物（docker 镜像 tar、fpk 包动辄数百 MB，禁止入 git）
*.tar.gz
*.tgz
*.fpk
pnpm-store/
.pnpm-store/
*.whl
